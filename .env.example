NODE_ENV=development
VARTMA_CONFIG_PATH=./configs/vartma.example.yaml
VARTMA_HOST=127.0.0.1
VARTMA_PORT=8080
VARTMA_API_KEYS=local-development-key
DATABASE_URL=postgresql://vartma:vartma@localhost:5432/vartma?schema=public
VARTMA_MASTER_KEY=

# Docker Compose deployment values. Use generated secrets, and URL-encode the database password
# inside VARTMA_DATABASE_URL when it contains reserved URL characters.
POSTGRES_DB=vartma
POSTGRES_USER=vartma
POSTGRES_PASSWORD=
VARTMA_DATABASE_URL=postgresql://vartma:replace-me@postgres:5432/vartma?schema=public
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_MODEL_API_KEY=local-development-key

# Optional development/evaluation export. Disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vartma-development
